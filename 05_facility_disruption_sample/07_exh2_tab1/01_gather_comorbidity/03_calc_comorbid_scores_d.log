422            /* ---------- CREATE FINAL COMBINED SCORE ---------- */
423            data &score_set;
424              set for_combined_comorbidity_score;
425        
426               combinedscore = (5 * Metastatic_cancer);
427               combinedscore + (Congestive_heart_failure * 2);
428               combinedscore + (Dementia * 2);
429               combinedscore + (Renal_failure * 2);
430               combinedscore + (Weight_loss * 2);
431               combinedscore + (Hemiplegia);
432               combinedscore + (Alcohol_abuse);
433               combinedscore + (Any_tumor);
434               combinedscore + (Cardiac_arrhythmias);
435               combinedscore + (Chronic_pulmonary_disease);
436               combinedscore + (Coagulopathy);
437               combinedscore + (Complicated_diabetes);
