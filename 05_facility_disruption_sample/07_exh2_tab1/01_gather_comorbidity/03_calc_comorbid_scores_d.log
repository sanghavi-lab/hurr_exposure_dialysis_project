439               combinedscore + (Fluid_and_electrolyte_disorders);
440               combinedscore + (Liver_disease);
441               combinedscore + (Peripheral_vascular_disease);
442               combinedscore + (Psychosis);
443               combinedscore + (Pulmonary_circulation_disorders);
444               combinedscore + (HIV_AIDS * -1);
445               combinedscore + (Hypertension * -1);
446        
447              keep patid combinedscore;
448            run;
