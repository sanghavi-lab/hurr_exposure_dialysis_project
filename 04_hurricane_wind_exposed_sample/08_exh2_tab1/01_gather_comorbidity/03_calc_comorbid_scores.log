345                              when Dx_CodeType = "09" and DX = "40492" then 1
346                              when Dx_CodeType = "09" and DX like "585%" then 1
347                              when Dx_CodeType = "09" and DX like "586%" then 1
348                              when Dx_CodeType = "09" and DX = "V420" then 1
349                              when Dx_CodeType = "09" and DX = "V451" then 1
350                              when Dx_CodeType = "09" and DX = "V560" then 1
351                              when Dx_CodeType = "09" and DX = "V568" then 1
352                              when Dx_CodeType = "10" and DX = "I120" then 1
353                              when Dx_CodeType = "10" and DX like "I13%" then 1
354                              when Dx_CodeType = "10" and DX >= "N032" and DX <= "N037" then 1
355                              when Dx_CodeType = "10" and DX >= "N052" and DX <= "N057" then 1
356                              when Dx_CodeType = "10" and DX like "N18%" then 1
357                              when Dx_CodeType = "10" and DX like "N19%" then 1
358                              when Dx_CodeType = "10" and DX = "N250" then 1
359                              when Dx_CodeType = "10" and DX = "Z3932" then 1
360                              when Dx_CodeType = "10" and DX = "Z4822" then 1
361                              when Dx_CodeType = "10" and DX like "Z490%" then 1
362                              when Dx_CodeType = "10" and DX = "Z4931" then 1
363                              when Dx_CodeType = "10" and DX = "Z9115" then 1
8                                                          The SAS System                               13:17 Tuesday, June 23, 2026

364                              when Dx_CodeType = "10" and DX = "Z940" then 1
365                              when Dx_CodeType = "10" and DX = "Z992" then 1
366                              else 0
367                         end) as Renal_failure,
368                     MAX(case when Dx_CodeType = "09" and DX >= "260" and substr(DX, 1, 3) <= "263" then 1
369                              when Dx_CodeType = "10" and DX >= "E40" and substr(DX, 1, 3) <= "E46" then 1
370                              when Dx_CodeType = "10" and DX = "E640" then 1
371                              when Dx_CodeType = "10" and DX = "R634" then 1
372                              when Dx_CodeType = "10" and DX = "R64" then 1
373                              else 0
374                         end) as Weight_loss
375              from &dx_set
376              group by patid
377              order by patid
378              ;
379            quit;
380        
381            /* ---------- CREATE FINAL COMBINED SCORE ---------- */
382            data &score_set;
383              set for_combined_comorbidity_score;
384        
385               combinedscore = (5 * Metastatic_cancer);
386               combinedscore + (Congestive_heart_failure * 2);
387               combinedscore + (Dementia * 2);
388               combinedscore + (Renal_failure * 2);
389               combinedscore + (Weight_loss * 2);
390               combinedscore + (Hemiplegia);
391               combinedscore + (Alcohol_abuse);
392               combinedscore + (Any_tumor);
393               combinedscore + (Cardiac_arrhythmias);
394               combinedscore + (Chronic_pulmonary_disease);
395               combinedscore + (Coagulopathy);
396               combinedscore + (Complicated_diabetes);
397               combinedscore + (Deficiency_anemia);
398               combinedscore + (Fluid_and_electrolyte_disorders);
399               combinedscore + (Liver_disease);
400               combinedscore + (Peripheral_vascular_disease);
401               combinedscore + (Psychosis);
402               combinedscore + (Pulmonary_circulation_disorders);
403               combinedscore + (HIV_AIDS * -1);
404               combinedscore + (Hypertension * -1);
405        
406              keep patid combinedscore;
407            run;
408        
409            /* ---------- WRITE-OUT ---------- */
410            proc export
411                data    = &score_set
412                dbms    = csv
413                outfile =
413      ! "/gpfs/data/cms-share/duas/54200/Jessy/data/climate_change/dialysis/05c_comorbidity_scores_from_sas_v01/year_&this_year._
413      ! sas_output.csv"
414                replace;
415            run;
416        
417            /* ---------- CLEAN WORK TABLES ---------- */
418            proc datasets library=work nolist;
419                delete diag_imp for_combined_comorbidity_score combined_comorb_score_set;
9                                                          The SAS System                               13:17 Tuesday, June 23, 2026

420            quit;
421        
422            /* increment loop */
423            %let i = %eval(&i + 1);
424            %let this_year = %scan(&year_list,&i,%str( ));
425        %end;
426        
427        %mend loop_years;
428        
429        /* run */
430        %loop_years;
